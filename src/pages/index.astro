---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Publication from '../components/Publication.astro';
import Placeholder from '../components/Placeholder.astro';
import { site } from '../site';
import { lookupAuthor, fullName } from '../authors';
import { externalLinksInHtml } from '../links';

const publications = (await getCollection('publications', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order || b.data.year - a.data.year
);

// Avatar: name a file avatar.jpg / .png / .webp and drop it into src/assets/.
// It is picked up automatically; until then the slot shows a placeholder.
// An optional avatar-hover.* alongside it is swapped in on hover.
const avatarModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/avatar.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);
const avatarHoverModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/avatar-hover.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);
const avatar = Object.values(avatarModules)[0]?.default;
const avatarHover = Object.values(avatarHoverModules)[0]?.default;

const greeting = site.greeting || `Hello, I'm ${site.name}`;

// The identity anchor for the whole site: `sameAs` is what lets a search engine
// or an AI system tie this page to the Scholar, GitHub and X profiles and treat
// them as one person rather than three unrelated accounts.
const origin = Astro.site!.origin;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${origin}/#person`,
      name: site.name,
      url: `${origin}/`,
      image: `${origin}/og.jpg`,
      jobTitle: 'Ph.D. Student',
      email: 'mailto:cni586@aucklanduni.ac.nz',
      affiliation: {
        '@type': 'CollegeOrUniversity',
        name: 'University of Auckland',
        url: 'https://www.auckland.ac.nz',
      },
      knowsAbout: ['Software supply chain security', 'Reproducible builds', 'Binary equivalence'],
      sameAs: site.links.filter((l) => l.href.startsWith('http')).map((l) => l.href),
    },
    ...publications.map((entry) => ({
      '@type': 'ScholarlyArticle',
      headline: entry.data.title,
      datePublished: String(entry.data.year),
      author: entry.data.authors.map((id) => ({
        '@type': 'Person',
        name: fullName(lookupAuthor(id, `${entry.id}.md`)),
      })),
      publisher: { '@type': 'Organization', name: entry.data.venue },
      ...(entry.data.pdf || entry.data.arxiv
        ? { url: entry.data.pdf ?? `https://arxiv.org/abs/${entry.data.arxiv}` }
        : {}),
      creator: { '@id': `${origin}/#person` },
    })),
  ],
};
---

<Base jsonLd={jsonLd}>
  <section class="band">
    <div class="wrap intro">
      <div class="intro__avatar">
        {avatar ? <Image src={avatar} alt={site.name} width={504} height={504} /> : <Placeholder />}
        {
          avatar && avatarHover && (
            <Image
              class="intro__avatar-hover"
              src={avatarHover}
              alt=""
              aria-hidden="true"
              width={504}
              height={504}
            />
          )
        }
      </div>

      <div class="intro__text">
        <h1>{greeting}</h1>
        {site.bio.map((para) => <p set:html={externalLinksInHtml(para)} />)}
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2>Publications</h2>
      {
        publications.length > 0 ? (
          publications.map((entry) => <Publication entry={entry} />)
        ) : (
          <p class="note">
            No entries yet — add a .md file under src/content/publications/.
          </p>
        )
      }
    </div>
  </section>
</Base>

<script>
  // Auto-blink for devices without hover.
  //
  // Timings follow a resting human blink: roughly 15–20 a minute, but the gaps
  // between them are irregular rather than metronomic, and blinks cluster —
  // a second often follows the first within a fifth of a second. The closed
  // phase is short; most of a blink is the eyelid travelling.
  const noHover = matchMedia('(hover: none)');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  const CLOSED_MS = 120;
  const MIN_GAP_MS = 2200;
  const GAP_SPREAD_MS = 4200;
  const DOUBLE_CHANCE = 0.2;
  const DOUBLE_GAP_MS = 180;

  let timer: ReturnType<typeof setTimeout> | undefined;

  const avatar = () => document.querySelector<HTMLElement>('.intro__avatar');

  function stop() {
    clearTimeout(timer);
    timer = undefined;
    avatar()?.classList.remove('is-blinking');
  }

  function schedule() {
    timer = setTimeout(blink, MIN_GAP_MS + Math.random() * GAP_SPREAD_MS);
  }

  function blink(isSecond = false) {
    const box = avatar();
    if (!box) return;

    // Don't blink into a background tab; just wait for the next slot.
    if (document.visibilityState !== 'visible') {
      schedule();
      return;
    }

    box.classList.add('is-blinking');
    timer = setTimeout(() => {
      box.classList.remove('is-blinking');
      if (!isSecond && Math.random() < DOUBLE_CHANCE) {
        timer = setTimeout(() => blink(true), DOUBLE_GAP_MS);
      } else {
        schedule();
      }
    }, CLOSED_MS);
  }

  function setup() {
    stop();
    const box = avatar();
    if (!box) return;

    const enabled = noHover.matches && !reduced.matches && !!box.querySelector('.intro__avatar-hover');
    box.toggleAttribute('data-blink', enabled);
    if (enabled) schedule();
  }

  setup();
  // ClientRouter swaps the body, so re-run against the new DOM.
  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', stop);
  // A tablet switching between touch and a trackpad flips (hover: none).
  noHover.addEventListener('change', setup);
  reduced.addEventListener('change', setup);
</script>

<style>
  /* Mobile stacks and centres everything; from md up it becomes a row and
     falls back to left alignment. */
  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2rem; /* 36px */
  }

  /* Square, sharp-cornered, 12rem on mobile and 14rem from md up. */
  .intro__avatar {
    position: relative;
    flex: 0 0 12rem;
    width: 12rem;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--fill);
  }

  .intro__avatar :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Both frames are stills, so the swap is pure CSS — no script, and the
     second image is fetched with the page rather than on first hover, which
     keeps the crossfade from stuttering the first time. */
  .intro__avatar :global(.intro__avatar-hover) {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .intro__avatar:hover :global(.intro__avatar-hover) {
    opacity: 1;
  }

  /*
   * Touch devices never get a hover, so the portrait inverts: eyes rest open
   * and close briefly on a timer. `data-blink` is set from script only when
   * the device actually lacks hover, so a mouse user is unaffected.
   *
   * The two directions are timed differently on purpose — a real eyelid shuts
   * in roughly half the time it takes to open again.
   */
  .intro__avatar[data-blink] :global(.intro__avatar-hover) {
    opacity: 1;
    transition: opacity 140ms ease-out;
  }

  .intro__avatar[data-blink].is-blinking :global(.intro__avatar-hover) {
    opacity: 0;
    transition: opacity 70ms ease-in;
  }

  @media (prefers-reduced-motion: reduce) {
    .intro__avatar :global(.intro__avatar-hover) {
      transition: none;
    }
  }

  .intro__text {
    flex: 1;
    width: 100%;
    min-width: 0;
  }

  .intro__text h1 {
    margin-bottom: 1rem;
  }

  /* Capped at a comfortable measure rather than filling the full 954px column.
     Centred along with the rest of the block on mobile; the media query below
     returns it to the left from md up. */
  .intro__text p {
    max-width: 65ch;
    margin-inline: auto;
  }

  @media (min-width: 768px) {
    /* Top-aligned: the name is the entry point and should sit level with the
       top of the photo. It also survives a longer bio — centring would leave
       the photo floating once the text column outgrows it. */
    .intro {
      flex-direction: row;
      align-items: flex-start;
      text-align: left;
    }

    .intro__avatar {
      flex-basis: 14rem;
      width: 14rem;
    }

    .intro__text p {
      margin-inline: 0;
    }
  }
</style>
