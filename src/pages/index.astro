---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Publication from '../components/Publication.astro';
import Placeholder from '../components/Placeholder.astro';
import { site } from '../site';
import { lookupAuthor, fullName } from '../authors';
import { externalLinksInHtml } from '../links';

const publications = (await getCollection('publications', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order || b.data.year - a.data.year
);

/*
 * Avatar. Drop files into src/assets/ and they are picked up automatically:
 *
 *   avatar.*             required — the resting frame
 *   avatar-hover.*       optional — swapped in on hover
 *   avatar-dark.*        optional — resting frame in dark mode
 *   avatar-hover-dark.*  optional — hover frame in dark mode
 *
 * Any of the three optional files can be left out; each falls back to its light
 * counterpart, and with none of them present the slot behaves as a single still.
 * With no avatar at all it shows a placeholder.
 */
const avatarFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/avatar*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);

// Matched on the full stem so `avatar-hover` cannot also pick up
// `avatar-hover-dark`, and `avatar` cannot pick up either of them.
const pickAvatar = (stem: string) =>
  Object.entries(avatarFiles).find(([path]) =>
    new RegExp(`/${stem}\\.[a-z]+$`).test(path)
  )?.[1].default;

const avatar = pickAvatar('avatar');
const avatarHover = pickAvatar('avatar-hover');
const avatarDark = pickAvatar('avatar-dark');
const avatarHoverDark = pickAvatar('avatar-hover-dark');

/*
 * The box is 14rem (252px) wide at its largest, so 252 is the 1x width and the
 * 2x/3x steps cover retina laptops and phones. Quality is raised above the
 * default: this is a photograph of a face at a size where the eyes are only a
 * few dozen pixels across, and default WebP leaves visible mottling in the skin.
 */
const renderAvatar = (image: ImageMetadata) =>
  getImage({ src: image, width: 252, densities: [2, 3], format: 'webp', quality: 90 });

const [restLight, restDark, hoverLight, hoverDark] = await Promise.all([
  avatar && renderAvatar(avatar),
  avatarDark && renderAvatar(avatarDark),
  avatarHover && renderAvatar(avatarHover),
  avatarHoverDark && renderAvatar(avatarHoverDark),
]);

const greeting = site.greeting || `Hello, I'm ${site.name}`;

// The identity anchor for the whole site: `sameAs` is what lets a search engine
// or an AI system tie this page to the Scholar, GitHub and X profiles and treat
// them as one person rather than three unrelated accounts.
const origin = Astro.site!.origin;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${origin}/#person`,
      name: site.name,
      url: `${origin}/`,
      image: `${origin}/og.jpg`,
      jobTitle: 'Ph.D. Student',
      email: 'mailto:cni586@aucklanduni.ac.nz',
      affiliation: {
        '@type': 'CollegeOrUniversity',
        name: 'University of Auckland',
        url: 'https://www.auckland.ac.nz',
      },
      knowsAbout: ['Software supply chain security', 'Reproducible builds', 'Binary equivalence'],
      sameAs: site.links.filter((l) => l.href.startsWith('http')).map((l) => l.href),
    },
    ...publications.map((entry) => ({
      '@type': 'ScholarlyArticle',
      headline: entry.data.title,
      datePublished: String(entry.data.year),
      author: entry.data.authors.map((id) => ({
        '@type': 'Person',
        name: fullName(lookupAuthor(id, `${entry.id}.md`)),
      })),
      publisher: { '@type': 'Organization', name: entry.data.venue },
      ...(entry.data.pdf || entry.data.arxiv
        ? { url: entry.data.pdf ?? `https://arxiv.org/abs/${entry.data.arxiv}` }
        : {}),
      creator: { '@id': `${origin}/#person` },
    })),
  ],
};
---

<Base jsonLd={jsonLd}>
  <section class="band">
    <div class="wrap intro">
      <div class="intro__avatar">
        {
          restLight ? (
            /* One <picture> per frame rather than four stacked layers: the
               browser evaluates the media query itself and fetches only the
               variant for the scheme in use, so a light-mode visitor never
               downloads the dark photographs. It also re-evaluates live, so
               switching the system theme swaps the portrait with it. */
            <picture>
              {restDark && (
                <source
                  media="(prefers-color-scheme: dark)"
                  srcset={`${restDark.src} 1x, ${restDark.srcSet.attribute}`}
                  width={252}
                  height={252}
                />
              )}
              <img
                src={restLight.src}
                srcset={restLight.srcSet.attribute}
                alt={site.name}
                width={252}
                height={252}
                draggable={false}
              />
            </picture>
          ) : (
            <Placeholder />
          )
        }
        {
          restLight && hoverLight && (
            <picture class="intro__avatar-hover">
              {hoverDark && (
                <source
                  media="(prefers-color-scheme: dark)"
                  srcset={`${hoverDark.src} 1x, ${hoverDark.srcSet.attribute}`}
                  width={252}
                  height={252}
                />
              )}
              <img
                src={hoverLight.src}
                srcset={hoverLight.srcSet.attribute}
                alt=""
                aria-hidden="true"
                width={252}
                height={252}
                draggable={false}
              />
            </picture>
          )
        }
      </div>

      <div class="intro__text">
        <h1>{greeting}</h1>
        {site.bio.map((para) => <p set:html={externalLinksInHtml(para)} />)}
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2>Publications</h2>
      {
        publications.length > 0 ? (
          publications.map((entry) => <Publication entry={entry} />)
        ) : (
          <p class="note">
            No entries yet — add a .md file under src/content/publications/.
          </p>
        )
      }
    </div>
  </section>
</Base>

<script>
  // Auto-blink for devices without hover.
  //
  // Timings follow a resting human blink: roughly 15–20 a minute, but the gaps
  // between them are irregular rather than metronomic, and blinks cluster —
  // a second often follows the first within a fifth of a second. The closed
  // phase is short; most of a blink is the eyelid travelling.
  const noHover = matchMedia('(hover: none)');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  const CLOSED_MS = 120;
  const MIN_GAP_MS = 2200;
  const GAP_SPREAD_MS = 4200;
  const DOUBLE_CHANCE = 0.2;
  const DOUBLE_GAP_MS = 180;

  let timer: ReturnType<typeof setTimeout> | undefined;

  const avatar = () => document.querySelector<HTMLElement>('.intro__avatar');

  function stop() {
    clearTimeout(timer);
    timer = undefined;
    avatar()?.classList.remove('is-blinking');
  }

  function schedule() {
    timer = setTimeout(blink, MIN_GAP_MS + Math.random() * GAP_SPREAD_MS);
  }

  function blink(isSecond = false) {
    const box = avatar();
    if (!box) return;

    // Don't blink into a background tab; just wait for the next slot.
    if (document.visibilityState !== 'visible') {
      schedule();
      return;
    }

    box.classList.add('is-blinking');
    timer = setTimeout(() => {
      box.classList.remove('is-blinking');
      if (!isSecond && Math.random() < DOUBLE_CHANCE) {
        timer = setTimeout(() => blink(true), DOUBLE_GAP_MS);
      } else {
        schedule();
      }
    }, CLOSED_MS);
  }

  function setup() {
    stop();
    const box = avatar();
    if (!box) return;

    const enabled = noHover.matches && !reduced.matches && !!box.querySelector('.intro__avatar-hover');
    box.toggleAttribute('data-blink', enabled);
    if (enabled) schedule();
  }

  /*
   * Keep the portrait on the right side of the colour scheme after load.
   *
   * <picture> runs its source selection once, when the image loads. Chromium
   * does not re-run it when a media query changes afterwards, so a tab left
   * open while the system switches to dark at sunset would keep the light
   * frame: a white square on a dark page.
   *
   * Re-assigning `srcset` to its own value is the whole fix. The value does not
   * change; setting the attribute is what queues "update the image data", and
   * that re-evaluates the <source media> against the scheme now in effect.
   *
   * Progressive enhancement: the markup alone is already correct on load, so
   * the only thing lost without this is the live switch.
   */
  const dark = matchMedia('(prefers-color-scheme: dark)');

  function syncScheme() {
    document
      .querySelectorAll<HTMLImageElement>('.intro__avatar picture img')
      .forEach((img) => (img.srcset = img.srcset));
  }

  setup();
  // ClientRouter swaps the body, so re-run against the new DOM.
  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:page-load', syncScheme);
  document.addEventListener('astro:before-swap', stop);
  // A tablet switching between touch and a trackpad flips (hover: none).
  noHover.addEventListener('change', setup);
  reduced.addEventListener('change', setup);
  dark.addEventListener('change', syncScheme);
</script>

<style>
  /* Mobile stacks and centres everything; from md up it becomes a row and
     falls back to left alignment. */
  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2rem; /* 36px */
  }

  /* Square, sharp-cornered, 12rem on mobile and 14rem from md up. */
  .intro__avatar {
    position: relative;
    flex: 0 0 12rem;
    width: 12rem;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--fill);
  }

  /* <picture> is inline by default and would collapse to the line box. Given
     the full square explicitly so the `height: 100%` below has something
     definite to resolve against, which is what `object-fit: cover` needs in
     order to crop rather than letterbox. */
  .intro__avatar :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .intro__avatar :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Both frames are stills, so the swap is pure CSS — no script, and the
     second image is fetched with the page rather than on first hover, which
     keeps the crossfade from stuttering the first time. */
  .intro__avatar :global(.intro__avatar-hover) {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  @media (hover: hover) {
    .intro__avatar:hover :global(.intro__avatar-hover) {
      opacity: 1;
    }
  }

  /*
   * Touch devices never get a hover, so the portrait inverts: eyes rest open
   * and close briefly on a timer. `data-blink` is set from script only when
   * the device actually lacks hover, so a mouse user is unaffected.
   *
   * The two directions are timed differently on purpose — a real eyelid shuts
   * in roughly half the time it takes to open again.
   */
  .intro__avatar[data-blink] :global(.intro__avatar-hover) {
    opacity: 1;
    transition: opacity 140ms ease-out;
  }

  .intro__avatar[data-blink].is-blinking :global(.intro__avatar-hover) {
    opacity: 0;
    transition: opacity 70ms ease-in;
  }

  @media (prefers-reduced-motion: reduce) {
    .intro__avatar :global(.intro__avatar-hover) {
      transition: none;
    }
  }

  .intro__text {
    flex: 1;
    width: 100%;
    min-width: 0;
  }

  .intro__text h1 {
    margin-bottom: 1rem;
  }

  /* The last paragraph's bottom margin sits inside this box — .intro__text is a
     flex item, so it establishes a formatting context and the margin cannot
     collapse out. Centring the portrait against the box therefore put it 11px
     below where the text visibly ends. Trailing space under the final line has
     nothing to separate anyway. */
  .intro__text > :last-child {
    margin-bottom: 0;
  }

  /* Capped at a comfortable measure rather than filling the full 954px column.
     Centred along with the rest of the block on mobile; the media query below
     returns it to the left from md up. */
  .intro__text p {
    max-width: 65ch;
    margin-inline: auto;
  }

  @media (min-width: 768px) {
    /* Portrait centred on the text block's midline. Worth knowing the
       trade-off: the name no longer sits level with the top of the photo, and
       if the bio grows much longer the photo ends up floating in the middle of
       a tall column. At two paragraphs the two blocks are close enough in
       height that centring reads as deliberate. */
    .intro {
      flex-direction: row;
      align-items: center;
      text-align: left;
    }

    .intro__avatar {
      flex-basis: 14rem;
      width: 14rem;
    }

    .intro__text p {
      margin-inline: 0;
    }
  }
</style>
