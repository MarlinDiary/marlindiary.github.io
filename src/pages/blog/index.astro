---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title="Blog">
  <section class="band">
    <div class="wrap">
      {/* The nav already says Blog, and a heading that repeats the tab it was
          reached from is a line of type that tells the reader nothing. Kept in
          the markup, hidden visually: a page with no h1 has no top level to
          hang its post titles off, which reads as a gap to a screen reader and
          to a search engine. */}
      <h1 class="visually-hidden">Blog</h1>

      {
        posts.length > 0 ? (
          <ul class="post-list">
            {posts.map((post) => (
              <li class="post">
                <a class="post__link" href={`/blog/${post.id}`}>
                  <h2 class="post__title">{post.data.title}</h2>
                  <p class="post__meta">
                    <time datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time>
                    {post.data.tags.length > 0 && (
                      <>
                        <span class="post__sep" aria-hidden="true">·</span>
                        <span class="post__tags">{post.data.tags.join(', ')}</span>
                      </>
                    )}
                  </p>
                  {post.data.description && <p class="post__desc">{post.data.description}</p>}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="note">No posts yet — add a .md file under src/content/blog/.</p>
        )
      }
    </div>
  </section>
</Base>

<style>
  .post-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* 36px of air on each side of the rule, and no rule after the last entry. */
  .post {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--hair);
  }

  .post + .post {
    margin-top: 2rem;
  }

  .post:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .post__link {
    display: block;
    text-decoration: none;
  }

  /* Display face at the section-heading size, not the publication-title face. */
  .post__title {
    margin: 0;
    font-family: var(--display);
    font-size: 1.5rem; /* 27px */
    font-weight: 600;
    line-height: 1.333;
    color: var(--ink);
  }

  .post__link:hover .post__title {
    color: var(--body);
  }

  .post__meta {
    margin: 0.25rem 0 0;
    font-size: 0.875rem;
    color: var(--muted);
  }

  /*
   * 0.5em a side, not the 0.25rem it started at. A word space in Crimson Pro
   * measures 2.95px at this size — the face sets tight — so the old gap was
   * barely three of them, and the middot has a comma on each side of it to
   * separate: one inside the date, one between the tags. It needs to read as a
   * wider break than the punctuation it is arbitrating.
   *
   * In `em` so it tracks the meta size rather than the root.
   */
  .post__sep {
    margin-inline: 0.5em;
  }

  /* One step darker than the date, the same distinction the post page makes. */
  .post__tags {
    color: var(--body);
  }

  .post__desc {
    margin: 0.5rem 0 0;
    color: var(--body);
    max-width: 65ch;
  }
</style>
