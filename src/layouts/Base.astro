---
import { ClientRouter } from 'astro:transitions';
import { site, nav } from '../site';
import Icon from '../components/Icon.astro';
import { linkAttrs } from '../links';
import { siteUpdated, siteUpdatedLabel } from '../updated';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Links the KaTeX stylesheet. Only set by pages whose content has math. */
  math?: boolean;
  /**
   * schema.org data for this page, emitted as JSON-LD. This is the machine
   * readable version of the page: search engines build their knowledge panels
   * from it, and it is the most reliable thing for an AI crawler to read,
   * since it states relationships the prose only implies.
   */
  jsonLd?: unknown;
}

const { title, description = site.description, math = false, jsonLd } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.jpg', Astro.site);
const pageTitle = title ? `${title} · ${site.name}` : site.name;

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Matches --bg in each scheme, so mobile browser chrome never sits on a
         different shade than the page it frames. -->
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fdfdfd" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#18181b" />
    {/* Transparent background, so the icon sits correctly on a light or a dark
        tab strip. The Apple icon is flattened onto white instead: iOS ignores
        transparency and composites the home-screen icon onto black. */}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_NZ" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.name} />

    {/* 1200×630 is the 1.91:1 ratio `summary_large_image` expects, so the card
        renders full width instead of as a small square thumbnail. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} — Blog`}
      href="/rss.xml"
    />

    {/* 28KB, and the fonts are only fetched for glyphs a formula actually uses. */}
    {math && <link rel="stylesheet" href="/katex/katex.min.css" />}

    {/* Only the body face is preloaded. It is the first thing painted on every
        page; preloading the rest would compete with it for bandwidth and delay
        the text that actually matters. */}
    <link
      rel="preload"
      href="/fonts/crimson-pro-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />}

    <ClientRouter />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="wrap">
      <nav class="nav">
        {
          nav.map((item) => (
            <a
              href={item.href}
              data-label={item.label}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="site-footer__links">
          {
            site.links.map((link) => (
              <a href={link.href} aria-label={link.label} title={link.label} {...linkAttrs(link.href)}>
                <Icon name={link.icon ?? 'link'} />
              </a>
            ))
          }
          {/* Deliberately not in site.links: that list is how to reach the
              person, and it also fills the CV header, where a feed has no place. */}
          <a href="/rss.xml" aria-label="RSS feed" title="RSS feed">
            <Icon name="rss" />
          </a>
        </div>

        <p class="site-footer__updated">
          Updated <time datetime={siteUpdated.toISOString()}>{siteUpdatedLabel}</time>
        </p>
      </div>
    </footer>
  </body>
</html>
