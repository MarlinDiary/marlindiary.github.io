---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { lookupAuthor, fullName } from '../authors';
import Icon from './Icon.astro';
import Placeholder from './Placeholder.astro';
import { linkAttrs } from '../links';
import { publicationLinks, primaryLink } from '../publications';

interface Props {
  entry: CollectionEntry<'publications'>;
}

const { entry } = Astro.props;
const {
  title,
  authors,
  venue,
  year,
  awards,
  blurb,
  image,
  imageAlt,
  imageHover,
  videoHover,
} = entry.data;

// Author ids resolved against the registry. A miss throws, so the build fails
// rather than the page quietly losing a co-author.
const byline = authors.map((id) => lookupAuthor(id, `${entry.id}.md`));

// Built in src/publications.ts, so the CV derives the same row from the same
// rule. The title goes wherever that row's first link goes.
const links = publicationLinks(entry.data);
const titleHref = primaryLink(entry.data);

/*
 * How wide the thumbnail actually renders, so the browser can pick a candidate
 * instead of always taking the largest. The arithmetic follows the layout:
 *
 *   .wrap  content is 954px, with 27px of padding either side
 *   < 768  the thumbnail is the full content column   -> 100vw - 54px
 *   >= 768 it is `flex: 0 0 20%` of that column       -> (100vw - 54px) * 0.2,
 *          settling at 191px once the column stops growing at 1008px
 *
 * Written in px rather than rem: `sizes` is evaluated before styles are
 * necessarily applied, so a rem here would resolve against the initial 16px
 * root size and not the 18px this site sets.
 */
const THUMB_SIZES =
  '(max-width: 767px) calc(100vw - 54px), (max-width: 1008px) calc((100vw - 54px) * 0.2), 191px';

/*
 * A fixed 382px was enough for the 191px desktop slot at 2x and nothing else.
 * On a phone the same thumbnail fills the column — around 700px — so it was
 * being stretched past twice its own size. These widths cover both ends; Astro
 * skips any that exceed the source, so a small original simply yields fewer
 * candidates rather than an upscaled, soft one.
 */
const THUMB_WIDTHS = [191, 382, 573, 800, 1200];
---

<article class="pub">
  <div class="pub__thumb">
    {
      image ? (
        <Image
          draggable={false}
          src={image}
          alt={imageAlt ?? title}
          widths={THUMB_WIDTHS}
          sizes={THUMB_SIZES}
          quality={90}
        />
      ) : (
        <Placeholder />
      )
    }
    {
      imageHover && (
        <Image
          draggable={false}
          class="pub__hover"
          src={imageHover}
          alt=""
          aria-hidden="true"
          widths={THUMB_WIDTHS}
          sizes={THUMB_SIZES}
          quality={90}
        />
      )
    }
    {
      videoHover && (
        <video
          class="pub__video"
          src={videoHover}
          muted
          loop
          playsinline
          preload="none"
          aria-hidden="true"
        />
      )
    }
  </div>

  <div class="pub__body">
    <h3>
      {titleHref ? <a class="pub__title" href={titleHref} {...linkAttrs(titleHref)}>{title}</a> : title}
    </h3>

    <p class="pub__authors">
      {
        byline.map((author, i) => (
          <>
            {i > 0 && ', '}
            {author.me ? (
              <b>{fullName(author)}</b>
            ) : author.website ? (
              <a href={author.website} {...linkAttrs(author.website)}>{fullName(author)}</a>
            ) : (
              fullName(author)
            )}
          </>
        ))
      }
    </p>

    <p class="pub__venue">
      {venue}, {year}
      {awards.map((award) => (
        <> &nbsp;<span class="pub__award">{award}</span></>
      ))}
    </p>

    <p class="pub__blurb">{blurb}</p>

    {
      links.length > 0 && (
        <div class="meta-links">
          {links.map((link) => (
            <a href={link.href} {...linkAttrs(link.href)}>
              <Icon name={link.icon} />
              {link.label}
            </a>
          ))}
        </div>
      )
    }
  </div>
</article>

<script>
  // Hover-to-play thumbnails. Delegated on document: ClientRouter swaps only
  // the body, so the listeners survive navigation. The flag stops
  // astro:page-load from registering them twice.
  if (!(window as any).__hoverVideoBound) {
    (window as any).__hoverVideoBound = true;

    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const SEL = '.pub__thumb';

    const hostOf = (event: Event) => {
      const target = event.target;
      return target instanceof Element ? target.closest(SEL) : null;
    };

    document.addEventListener('pointerover', (event) => {
      if (reduced.matches) return;
      const host = hostOf(event);
      if (!host) return;
      const from = (event as PointerEvent).relatedTarget;
      if (from instanceof Node && host.contains(from)) return;
      host.querySelector('video')?.play().catch(() => {});
    });

    document.addEventListener('pointerout', (event) => {
      const host = hostOf(event);
      if (!host) return;
      const to = (event as PointerEvent).relatedTarget;
      if (to instanceof Node && host.contains(to)) return;
      const video = host.querySelector('video');
      if (video) {
        video.pause();
        video.currentTime = 0;
      }
    });
  }
</script>

<style>
  /* align-items must be set: the default stretch would override the
     thumbnail's aspect-ratio and pull it out of square whenever the text
     column is taller. Top-aligned rather than centred, so every entry in the
     list shares one top edge regardless of how long its text runs. */
  /* Thumbnail centred against the text block, not hung from its top edge.
     Anything but the default `stretch` will do — stretch overrides the
     thumbnail's aspect-ratio and it stops being square. */
  .pub {
    display: flex;
    align-items: center;
    gap: 1.5rem; /* 27px */
    padding: 1.5rem 0;
  }

  /*
   * The vertical padding separates one entry from the next — 27px from each
   * side making 54px between them. The first and last entries have nothing on
   * that side to separate from, so their share lands on the section's own
   * spacing instead: the heading gap grew from 36px to 63px, and the boundary
   * to the next section from 72px to 99px. Dropped at both ends, so the
   * padding only ever does the job it was set for.
   *
   * `:first-of-type` rather than `:first-child` — the <h2> is the first child
   * of the column, so `:first-child` would match nothing.
   */
  .pub:first-of-type {
    padding-top: 0;
  }

  .pub:last-child {
    padding-bottom: 0;
  }

  /* 20% of the content column (954 → 191). The radius lives on this wrapper
     with overflow hidden, which is why reading border-radius off the <img>
     reports 0. */
  .pub__thumb {
    position: relative;
    flex: 0 0 20%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 0.5rem; /* 9px */
    background: var(--fill);
  }

  .pub__thumb :global(img),
  .pub__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Both hover layers sit on top of the still and fade in. Pure CSS, so a
     touch device — which never fires hover — just keeps the still. */
  .pub__thumb :global(.pub__hover),
  .pub__video {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.18s ease;
  }

  /* Gated on a real pointer. A touch device fires :hover on tap and then keeps
     it applied until the next tap elsewhere, so without this the second image
     would stick on after being touched. */
  @media (hover: hover) {
    .pub__thumb:hover :global(.pub__hover),
    .pub__thumb:hover .pub__video {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pub__thumb :global(.pub__hover),
    .pub__video {
      transition: none;
    }
  }

  .pub__body {
    flex: 1;
    min-width: 0;
  }

  /* No underline, on hover either — the title signals itself by lightening.
     Underlines are reserved for links inside running text. */
  .pub__title {
    color: var(--ink);
    text-decoration: none;
  }

  .pub__title:hover {
    color: var(--body);
  }

  .pub__authors {
    margin: 0.375rem 0 0;
    font-size: 0.875rem;
    color: var(--body);
  }

  .pub__authors b {
    font-weight: 600;
    color: var(--ink);
  }

  .pub__venue {
    margin: 0.25rem 0 0;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .pub__award {
    font-weight: 600;
    color: var(--ink);
  }

  .pub__blurb {
    margin: 0.75rem 0 0;
    color: var(--body);
    max-width: 65ch;
  }

  .pub__body .meta-links {
    margin-top: 0.75rem;
  }

  @media (max-width: 767px) {
    .pub {
      flex-direction: column;
      /* Stacked, so align-items now governs width. Centring here would shrink
         the text block to its own content and pull it off the left margin. */
      align-items: stretch;
    }

    /* Full width, cropped to 4:3. A full-width square would take most of the
       screen height before any text appeared. */
    .pub__thumb {
      flex-basis: auto;
      width: 100%;
      aspect-ratio: 4 / 3;
    }
  }
</style>
