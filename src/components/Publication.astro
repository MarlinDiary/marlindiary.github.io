---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { lookupAuthor, fullName } from '../authors';
import Icon from './Icon.astro';
import Placeholder from './Placeholder.astro';
import { linkAttrs } from '../links';

interface Props {
  entry: CollectionEntry<'publications'>;
}

const { entry } = Astro.props;
const {
  title,
  authors,
  venue,
  year,
  awards,
  blurb,
  image,
  imageAlt,
  imageHover,
  videoHover,
  project,
  dataset,
  arxiv,
  github,
  pdf,
  links: extraLinks,
} = entry.data;

// Author ids resolved against the registry. A miss throws, so the build fails
// rather than the page quietly losing a co-author.
const byline = authors.map((id) => lookupAuthor(id, `${entry.id}.md`));

// Shorthand expanded into full links.
const links: { label: string; href: string; icon: string }[] = [];
if (project) links.push({ label: 'Project', href: project, icon: 'link' });
if (dataset) links.push({ label: 'Dataset', href: dataset, icon: 'dataset' });
if (pdf) links.push({ label: 'PDF', href: pdf, icon: 'pdf' });
else if (arxiv) links.push({ label: 'PDF', href: `https://arxiv.org/pdf/${arxiv}`, icon: 'pdf' });
if (arxiv) links.push({ label: 'arXiv', href: `https://arxiv.org/abs/${arxiv}`, icon: 'arxiv' });
if (github) links.push({ label: 'Code', href: `https://github.com/${github}`, icon: 'code' });
links.push(...extraLinks.map((l) => ({ ...l, icon: l.icon ?? 'link' })));

// The title links to the paper itself — an explicit order, not simply the
// first entry in the row: the dataset now sorts ahead of the paper links, and
// a title pointing at a data archive is the wrong destination.
const titleHref =
  project ?? pdf ?? (arxiv ? `https://arxiv.org/abs/${arxiv}` : undefined) ?? links[0]?.href;
---

<article class="pub">
  <div class="pub__thumb">
    {
      image ? (
        <Image src={image} alt={imageAlt ?? title} width={382} height={382} />
      ) : (
        <Placeholder />
      )
    }
    {
      imageHover && (
        <Image
          class="pub__hover"
          src={imageHover}
          alt=""
          aria-hidden="true"
          width={382}
          height={382}
        />
      )
    }
    {
      videoHover && (
        <video
          class="pub__video"
          src={videoHover}
          muted
          loop
          playsinline
          preload="none"
          aria-hidden="true"
        />
      )
    }
  </div>

  <div class="pub__body">
    <h3>
      {titleHref ? <a class="pub__title" href={titleHref} {...linkAttrs(titleHref)}>{title}</a> : title}
    </h3>

    <p class="pub__authors">
      {
        byline.map((author, i) => (
          <>
            {i > 0 && ', '}
            {author.me ? (
              <b>{fullName(author)}</b>
            ) : author.website ? (
              <a href={author.website} {...linkAttrs(author.website)}>{fullName(author)}</a>
            ) : (
              fullName(author)
            )}
          </>
        ))
      }
    </p>

    <p class="pub__venue">
      {venue}, {year}
      {awards.map((award) => (
        <> &nbsp;<span class="pub__award">{award}</span></>
      ))}
    </p>

    <p class="pub__blurb">{blurb}</p>

    {
      links.length > 0 && (
        <div class="meta-links">
          {links.map((link) => (
            <a href={link.href} {...linkAttrs(link.href)}>
              <Icon name={link.icon} />
              {link.label}
            </a>
          ))}
        </div>
      )
    }
  </div>
</article>

<script>
  // Hover-to-play thumbnails. Delegated on document: ClientRouter swaps only
  // the body, so the listeners survive navigation. The flag stops
  // astro:page-load from registering them twice.
  if (!(window as any).__hoverVideoBound) {
    (window as any).__hoverVideoBound = true;

    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const SEL = '.pub__thumb';

    const hostOf = (event: Event) => {
      const target = event.target;
      return target instanceof Element ? target.closest(SEL) : null;
    };

    document.addEventListener('pointerover', (event) => {
      if (reduced.matches) return;
      const host = hostOf(event);
      if (!host) return;
      const from = (event as PointerEvent).relatedTarget;
      if (from instanceof Node && host.contains(from)) return;
      host.querySelector('video')?.play().catch(() => {});
    });

    document.addEventListener('pointerout', (event) => {
      const host = hostOf(event);
      if (!host) return;
      const to = (event as PointerEvent).relatedTarget;
      if (to instanceof Node && host.contains(to)) return;
      const video = host.querySelector('video');
      if (video) {
        video.pause();
        video.currentTime = 0;
      }
    });
  }
</script>

<style>
  /* align-items must be set: the default stretch would override the
     thumbnail's aspect-ratio and pull it out of square whenever the text
     column is taller. Top-aligned rather than centred, so every entry in the
     list shares one top edge regardless of how long its text runs. */
  .pub {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem; /* 27px */
    padding: 1.5rem 0;
  }

  /* 20% of the content column (954 → 191). The radius lives on this wrapper
     with overflow hidden, which is why reading border-radius off the <img>
     reports 0. */
  .pub__thumb {
    position: relative;
    flex: 0 0 20%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 0.5rem; /* 9px */
    background: var(--fill);
  }

  .pub__thumb :global(img),
  .pub__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Both hover layers sit on top of the still and fade in. Pure CSS, so a
     touch device — which never fires hover — just keeps the still. */
  .pub__thumb :global(.pub__hover),
  .pub__video {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.18s ease;
  }

  .pub__thumb:hover :global(.pub__hover),
  .pub__thumb:hover .pub__video {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .pub__thumb :global(.pub__hover),
    .pub__video {
      transition: none;
    }
  }

  .pub__body {
    flex: 1;
    min-width: 0;
  }

  /* No underline, on hover either — the title signals itself by lightening.
     Underlines are reserved for links inside running text. */
  .pub__title {
    color: var(--ink);
    text-decoration: none;
  }

  .pub__title:hover {
    color: var(--body);
  }

  .pub__authors {
    margin: 0.375rem 0 0;
    font-size: 0.875rem;
    color: var(--body);
  }

  .pub__authors b {
    font-weight: 600;
    color: var(--ink);
  }

  .pub__venue {
    margin: 0.25rem 0 0;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .pub__award {
    font-weight: 600;
    color: var(--ink);
  }

  .pub__blurb {
    margin: 0.75rem 0 0;
    color: var(--body);
    max-width: 65ch;
  }

  .pub__body .meta-links {
    margin-top: 0.75rem;
  }

  @media (max-width: 767px) {
    .pub {
      flex-direction: column;
    }

    /* Stays a square on mobile — full width, not a 16:9 letterbox. */
    .pub__thumb {
      flex-basis: auto;
      width: 100%;
    }
  }
</style>
